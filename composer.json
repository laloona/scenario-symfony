{
  "name": "stateforge/scenario-symfony",
  "description": "Symfony adapter for Stateforge Scenario Core – declarative, attribute-driven scenario execution for reproducible application state.",
  "type": "symfony-bundle",
  "keywords": [
    "testing",
    "phpunit",
    "fixtures",
    "scenario",
    "state",
    "test-data",
    "symfony"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Christina Koenig",
      "email": "christina.koenig@looriva.de",
      "role": "lead"
    }
  ],
  "homepage": "https://github.com/laloona/scenario-symfony",
  "support": {
    "issues": "https://github.com/laloona/scenario-symfony/issues",
    "source": "https://github.com/laloona/scenario-symfony"
  },
  "require": {
    "php": ">=8.2",
    "stateforge/scenario-core": "~1.1.0",
    "doctrine/doctrine-bundle": "^2.10",
    "doctrine/orm": "^2.16 || ^3.0",
    "symfony/framework-bundle": "^6.4 || ^7.0",
    "symfony/dotenv": "^6.4 || ^7.0",
    "symfony/console": "^6.4 || ^7.0",
    "symfony/finder": "^6.4 || ^7.0",
    "symfony/validator": "^6.4 || ^7.0",
    "symfony/messenger": "^6.4 || ^7.0",
    "symfony/yaml": "^6.4 || ^7.0",
    "symfony/intl": "^6.4 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "Stateforge\\Scenario\\Symfony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Stateforge\\Scenario\\Symfony\\Tests\\Unit\\": "tests/unit/"
    },
    "classmap": [
      "tests/files"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.60",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5.50 || ^12.5.22 || ^13.1.6",
    "tomasvotruba/type-coverage": "^2.2"
  },
  "extra": {
    "symfony": {
      "bundles": {
        "Stateforge\\Scenario\\Symfony\\ScenarioBundle": [
          "all"
        ]
      }
    },
    "branch-alias": {
      "dev-main": "1.2-dev"
    }
  }
}
