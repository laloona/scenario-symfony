{
  "name": "scenario/symfony",
  "description": "Symfony integration for Scenario Core with Doctrine-based database scenario execution.",
  "type": "symfony-bundle",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Christina Koenig",
      "email": "christina.koenig@looriva.de",
      "role": "lead"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-dom": "*",
    "scenario/core": "dev-main",
    "symfony/framework-bundle": "^6.4 || ^7.0",
    "symfony/dotenv": "^6.4 || ^7.0",
    "symfony/console": "^6.4 || ^7.0",
    "symfony/finder": "^6.4 || ^7.0",
    "doctrine/doctrine-bundle": "^2.10",
    "doctrine/orm": "^2.16 || ^3.0",
    "symfony/messenger": "^6.4 || ^7.0",
    "symfony/yaml": "^6.4 || ^7.0"
  },
  "autoload": {
    "psr-4": { "Scenario\\Symfony\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": {
      "Scenario\\Symfony\\Tests\\Unit\\": "tests/unit/"
    },
    "classmap": ["tests/files"]
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.60",
    "phpstan/phpstan-strict-rules": "^2.0"
  },
  "extra": {
    "symfony": {
      "bundles": {
        "Scenario\\Symfony\\ScenarioBundle": ["all"]
      }
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:laloona/scenario-core.git"
    }
  ]
}
